@page "/products"
@using ECommerce.Web.Services
@inject CatalogApiClient Catalog
@inject OrderingApiClient Ordering
@rendermode InteractiveServer

<PageTitle>Catalog</PageTitle>

<h1>Catalog</h1>

@if (_products is null)
{
    <p><em>Loading products…</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Description</th>
                <th class="text-end">Price</th>
                <th class="text-end">Stock</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _products)
            {
                <tr>
                    <td>@p.Name</td>
                    <td>@p.Description</td>
                    <td class="text-end">@p.Price.ToString("C")</td>
                    <td class="text-end">@p.AvailableStock</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => AddToCart(p)">Add</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h2>Cart</h2>
    @if (_cart.Count == 0)
    {
        <p><em>Your cart is empty.</em></p>
    }
    else
    {
        <ul>
            @foreach (var line in _cart)
            {
                <li>@line.Value × @line.Key.Name (@line.Key.Price.ToString("C"))</li>
            }
        </ul>

        <div class="mb-3">
            <label class="form-label">Promo code</label>
            <div class="input-group" style="max-width: 320px">
                <input class="form-control" placeholder="e.g. WELCOME10" @bind="_promoInput" disabled="@(_promo is not null)" />
                @if (_promo is null)
                {
                    <button class="btn btn-outline-secondary" @onclick="ApplyPromo" disabled="@_checkingPromo">Apply</button>
                }
                else
                {
                    <button class="btn btn-outline-danger" @onclick="RemovePromo">Remove</button>
                }
            </div>
            @if (_promo is not null)
            {
                <div class="text-success mt-1">Code @_promo.Code applied: -@_promo.PercentOff%</div>
            }
            else if (!string.IsNullOrEmpty(_promoError))
            {
                <div class="text-danger mt-1">@_promoError</div>
            }
        </div>

        <p>
            Subtotal: @Subtotal.ToString("C")
            @if (_promo is not null)
            {
                <br />
                <span>Discount (@_promo.PercentOff%): -@Discount.ToString("C")</span>
            }
            <br />
            <strong>Total: @Total.ToString("C")</strong>
        </p>

        <div class="mb-2">
            <label class="form-label">Customer name</label>
            <input class="form-control" style="max-width: 320px" @bind="_customer" />
        </div>
        <button class="btn btn-primary" @onclick="PlaceOrder" disabled="@_placing">Place order</button>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") mt-3">@_message</div>
    }
}

@code {
    private IReadOnlyList<ProductDto>? _products;
    private readonly Dictionary<ProductDto, int> _cart = new();
    private string _customer = "";
    private bool _placing;
    private string? _message;
    private bool _isError;
    private string _promoInput = "";
    private PromoCodeDto? _promo;
    private string? _promoError;
    private bool _checkingPromo;

    private decimal Subtotal => _cart.Sum(c => c.Key.Price * c.Value);
    private decimal Discount => _promo is null
        ? 0m
        : Math.Round(Subtotal * _promo.PercentOff / 100m, 2, MidpointRounding.AwayFromZero);
    private decimal Total => Subtotal - Discount;

    protected override async Task OnInitializedAsync()
    {
        _products = await Catalog.GetProductsAsync();
    }

    private async Task ApplyPromo()
    {
        _promoError = null;
        if (string.IsNullOrWhiteSpace(_promoInput))
        {
            _promoError = "Enter a promo code.";
            return;
        }

        _checkingPromo = true;
        try
        {
            _promo = await Ordering.GetPromoCodeAsync(_promoInput);
            if (_promo is null)
            {
                _promoError = "This promo code is invalid or expired.";
            }
        }
        catch (HttpRequestException)
        {
            _promoError = "Could not check the promo code. Please try again.";
        }
        finally
        {
            _checkingPromo = false;
        }
    }

    private void RemovePromo()
    {
        _promo = null;
        _promoInput = "";
        _promoError = null;
    }

    private void AddToCart(ProductDto product)
    {
        _cart[product] = _cart.TryGetValue(product, out var qty) ? qty + 1 : 1;
        _message = null;
    }

    private async Task PlaceOrder()
    {
        if (string.IsNullOrWhiteSpace(_customer))
        {
            _message = "Please enter a customer name.";
            _isError = true;
            return;
        }

        _placing = true;
        var order = new CreateOrderDto(
            _customer,
            _cart.Select(c => new OrderLineDto(c.Key.Id, c.Value)).ToList(),
            _promo?.Code);

        var (success, error) = await Ordering.CreateOrderAsync(order);
        _placing = false;

        if (success)
        {
            _message = "Order placed successfully!";
            _isError = false;
            _cart.Clear();
            _customer = "";
            RemovePromo();
        }
        else
        {
            _message = $"Failed to place order: {error}";
            _isError = true;
        }
    }
}
